<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetHeadline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/widget_body</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetMeta">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
